generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  username  String
  email     String   @unique
  password  String
  coins     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

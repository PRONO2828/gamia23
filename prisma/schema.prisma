generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_POSTGRES_URL_NON_POOLING")
}

model User {
  id            String   @id @default(cuid())
  username      String
  email         String   @unique
  password      String
  coins         Int      @default(0)
  payoutMethod  String?
  payoutNetwork String?
  payoutAddress String?
  // Two-letter ISO country code from the CDN's geo header, captured at signup
  // and backfilled on login for accounts that predate this field.
  country       String?
  // Counts one visit per successful sign-in, so a refresh does not inflate it.
  visits        Int      @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

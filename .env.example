# ---- Database (required) ----
# A Postgres connection string. Use Vercel Postgres or Neon (both have free tiers).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Session security (required) ----
# Any long random string. Generate with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Admin login (required) ----
# The credentials you use to log into /admin
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="pick-a-strong-admin-password"

# ---- Coin conversion (optional, defaults to 1000) ----
# How many coins equal $1.
COINS_PER_DOLLAR="1000"

# ---- Email notifications (optional) ----
# Get a free API key at https://resend.com. If left blank, the app still
# works — it just logs signups to the server console instead of emailing.
RESEND_API_KEY=""
# Where signup notifications are sent (fill this in at deploy):
NOTIFY_EMAIL=""
# The "from" address. With Resend's test setup you can use onboarding@resend.dev
EMAIL_FROM="Gamia23 <onboarding@resend.dev>"
